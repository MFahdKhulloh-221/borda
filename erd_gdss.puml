@startuml ERD_GDSS_Laptop_Lab

' ====================================================================
' Pengaturan Visual: Tajam (DPI tinggi), garis rapi, proporsional A4
' ====================================================================
hide circle
hide empty members
skinparam dpi 200
skinparam linetype polyline
skinparam shadowing false
skinparam roundcorner 10
skinparam nodesep 45
skinparam ranksep 65
skinparam padding 4
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam package {
  BackgroundColor #FAFAFC
  BorderColor #CBD5E1
  FontColor #334155
  FontStyle bold
  RoundCorner 12
}

skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #4F46E5
  FontColor #1E293B
  AttributeFontSize 11
}

skinparam ArrowColor #475569
skinparam ArrowThickness 1.3
skinparam ArrowFontSize 10
skinparam ArrowFontColor #334155

title **Entity Relationship Diagram (ERD)**\nGDSS Pemilihan Laptop Laboratorium Komputer (Weighted Product + Borda)\n

' ====================================================================
' 1. MODUL MASTER DATA
' ====================================================================
package "1. Master Data" as pkg_master #F8FAFF {

  entity "users" as users #EEF2FF {
    * **id** : INT [PK]
    --
    * username : VARCHAR(50) [UK]
    * password_hash : VARCHAR(255)
    * name : VARCHAR(100)
    * role : VARCHAR(60)
    * rank_level : TINYINT
    * icon : VARCHAR(40)
    * focus : VARCHAR(255)
    * created_at : TIMESTAMP
  }

  entity "criteria" as criteria #EEF2FF {
    * **id** : VARCHAR(10) [PK]
    --
    * name : VARCHAR(80)
    * type : ENUM('cost','benefit')
    * icon : VARCHAR(40)
    * description : VARCHAR(160)
    * plain_text : VARCHAR(160)
    * scale_low : VARCHAR(50)
    * scale_high : VARCHAR(50)
    * scale_desc : VARCHAR(160)
    * sort_order : TINYINT
  }

  entity "alternatives" as alternatives #EEF2FF {
    * **id** : VARCHAR(10) [PK]
    --
    * name : VARCHAR(100) [UK]
    * price : BIGINT
    * cpu : VARCHAR(100)
    * ram : SMALLINT
    * battery : DECIMAL(4,1)
    * warranty : TINYINT
    note : TEXT
    * updated_at : TIMESTAMP
  }

  entity "user_preset_weights" as user_preset_weights #EEF2FF {
    * **user_id** : INT [PK, FK]
    * **criteria_id** : VARCHAR(10) [PK, FK]
    --
    * preset_weight : TINYINT
  }

  entity "alternative_ratings" as alternative_ratings #EEF2FF {
    * **alternative_id** : VARCHAR(10) [PK, FK]
    * **criteria_id** : VARCHAR(10) [PK, FK]
    --
    * rating : TINYINT
  }
}

' ====================================================================
' 2. MODUL PENILAIAN INDIVIDU (WEIGHTED PRODUCT)
' ====================================================================
package "2. Penilaian Individu (Weighted Product)" as pkg_wp #F2FDF8 {

  entity "submissions" as submissions #ECFDF5 {
    * **id** : INT [PK]
    --
    * user_id : INT [UK, FK]
    * status : ENUM('draft','submitted')
    sum_weight : DECIMAL(10,4)
    sum_vector_s : DECIMAL(14,8)
    submitted_at : DATETIME
    * updated_at : TIMESTAMP
  }

  entity "submission_weights" as submission_weights #ECFDF5 {
    * **id** : INT [PK]
    --
    * submission_id : INT [FK]
    * criteria_id : VARCHAR(10) [FK]
    * weight : TINYINT
    normalized_weight : DECIMAL(10,6)
    exponent : DECIMAL(10,6)
  }

  entity "submission_scores" as submission_scores #ECFDF5 {
    * **id** : INT [PK]
    --
    * submission_id : INT [FK]
    * alternative_id : VARCHAR(10) [FK]
    * criteria_id : VARCHAR(10) [FK]
    * score : TINYINT
    term_value : DECIMAL(14,8)
  }

  entity "wp_results" as wp_results #ECFDF5 {
    * **id** : INT [PK]
    --
    * submission_id : INT [FK]
    * alternative_id : VARCHAR(10) [FK]
    * vector_s : DECIMAL(14,8)
    * vector_v : DECIMAL(14,8)
    * rank_position : SMALLINT
    * borda_points : DECIMAL(8,4)
  }
}

' ====================================================================
' 3. MODUL KONSENSUS KELOMPOK (BORDA)
' ====================================================================
package "3. Konsensus Kelompok (Borda)" as pkg_borda #FFFDF2 {

  entity "consensus_sessions" as consensus_sessions #FEF3C7 {
    * **id** : INT [PK]
    --
    * run_by_user_id : INT [FK]
    * winner_alternative_id : VARCHAR(10) [FK]
    * grand_total_points : DECIMAL(10,4)
    * tie_at_top : TINYINT(1)
    * run_at : DATETIME
  }

  entity "consensus_details" as consensus_details #FEF3C7 {
    * **id** : INT [PK]
    --
    * consensus_id : INT [FK]
    * alternative_id : VARCHAR(10) [FK]
    * total_points : DECIMAL(10,4)
    * borda_weight : DECIMAL(10,6)
    * final_rank : SMALLINT
  }
}

' ====================================================================
' TATA LETAK & RELASI (CROW'S FOOT)
' ====================================================================

' Susun baris atas agar berurutan: users - criteria - alternatives
users -[hidden]r- criteria
criteria -[hidden]r- alternatives

' Relasi Master Data
users ||-d-o{ user_preset_weights : "preset"
criteria ||-d-o{ user_preset_weights : "kriteria"

alternatives ||-d-o{ alternative_ratings : "referensi"
criteria ||-d-o{ alternative_ratings : "kriteria"

' Relasi Penilaian WP
users ||-d-o| submissions : "mengisi"
submissions ||-d-o{ submission_weights : "bobot"
submissions ||-d-o{ submission_scores : "nilai Xij"
submissions ||-d-o{ wp_results : "hasil WP"

criteria ||-d-o{ submission_weights : "dibobotkan"
criteria ||-d-o{ submission_scores : "kriteria"
alternatives ||-d-o{ submission_scores : "dinilai"
alternatives ||-d-o{ wp_results : "skor S & V"

' Relasi Konsensus Borda
users ||-d-o{ consensus_sessions : "menjalankan"
alternatives ||-d-o{ consensus_sessions : "pemenang"
consensus_sessions ||-d-o{ consensus_details : "rincian"
alternatives ||-d-o{ consensus_details : "poin Borda"

' Susun urutan horizontal di baris detail agar minim persilangan garis
submission_weights -[hidden]r- submission_scores
submission_scores -[hidden]r- wp_results
submissions -[hidden]r- consensus_sessions
wp_results -[hidden]r- consensus_details

legend right
  |= Simbol |= Keterangan |
  | <b>*</b> | NOT NULL (wajib diisi) |
  | [PK] | Primary Key |
  | [FK] | Foreign Key |
  | [UK] | Unique Key |
end legend

@enduml
